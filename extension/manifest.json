{
  "manifest_version": 3,
  "name": "Mind Place Capture",
  "short_name": "Mind Place",
  "version": "1.3.1",
  "minimum_chrome_version": "105",
  "description": "Save the currently open ChatGPT conversation to your local Mind Place archive.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "optional_host_permissions": ["https://chatgpt.com/*"],
  "background": {
    "service_worker": "worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Save this conversation to Mind Place",
    "default_popup": "popup.html"
  }
}
